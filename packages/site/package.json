{
  "name": "@elecmonkey/garden-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rs build && SSG_WORKERS=auto node .rsbuild/ssg/build.js",
    "build:compiler": "pnpm --filter @elecmonkey/garden-content-compiler build",
    "build:with-compiler": "pnpm run build:compiler && pnpm run build",
    "dev": "rs dev --environment web",
    "lint": "pnpm --workspace-root exec rs lint --type-check packages/site",
    "preview": "rs preview --environment web",
    "start": "rs preview --environment web"
  },
  "dependencies": {
    "@elecmonkey/garden-content-compiler": "0.2.4",
    "@viz-js/viz": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-tailwindcss": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:"
  }
}
